{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "check": {
      "dependsOn": ["lint", "typecheck", "test"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pkg/eslint-config/*.js",
        "$TURBO_ROOT$/pkg/eslint-config/package.json"
      ]
    },
    "test": {},
    "typecheck": {}
  }
}
