{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    // Formatting and import order belong to Oxfmt.
    "sort-imports": "off",
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    // Shared rules also apply to Node.js code.
    "import/no-nodejs-modules": "off",
    // Allow separate declarations, numeric literals, and ternary expressions.
    "one-var": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    // Property names may be dictated by external APIs.
    "id-length": ["error", { "properties": "never" }],
    // Preserve meaningful object order and freely written comments.
    "sort-keys": "off",
    "capitalized-comments": "off",
    // Both named and default exports are useful public APIs.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // Keep exports inline with their declarations.
    "import/exports-last": "off",
    "import/group-exports": "off",
    "func-style": ["error", "declaration"],

    // Existing template preferences beyond the category defaults.
    "curly": "error",
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/consistent-indexed-object-style": ["error", "index-signature"],
    "typescript/array-type": ["error", { "default": "array" }],
    "typescript/require-await": "off",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.*", "**/*.spec.*"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
      "rules": {
        // Test cases use explicit Vitest imports.
        "vitest/no-importing-vitest-globals": "off",
        // Keep string suite titles, as required by vitest/valid-title.
        "vitest/prefer-describe-function-title": "off"
      }
    }
  ]
}
